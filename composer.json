{
  "name": "sailantis/azera-roadrunner",
  "description": "Application-server adapter that lets Azera run on RoadRunner. Serves HTTP and gRPC from persistent PHP workers that reuse the Azera AppContext DI container, Router, Dispatcher and middleware pipeline.",
  "type": "library",
  "license": "MIT",
  "repositories": [
    { "type": "path", "url": "../azera-framework" },
    { "type": "path", "url": "../clarity-engine" }
  ],
  "require": {
    "php": ">=8.1",
    "sailantis/azera-framework": "dev-main",
    "spiral/roadrunner": "^2025.1",
    "spiral/roadrunner-http": "^3.5",
    "spiral/roadrunner-grpc": "^3.0",
    "nyholm/psr7": "^1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "spiral/roadrunner-cli": "^2.7"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Azera\\RR\\": "src/",
      "GRPC\\": "generated/GRPC/",
      "GPBMetadata\\": "generated/GPBMetadata/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "proto": "php bin/proto.php"
  }
}
